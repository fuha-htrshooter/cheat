param(
    # 入力アーカイブ名
    [string]$targetTarGz = "*.tar.gz",
    # 作業用ディレクトリ名
    [string]$baseDir = "$pwd\yyyymm",
    # リストファイル名
    [string]$listFile = "リストファイル.txt"
)

# 作業用ディレクトリへ展開
if (Test-Path $baseDir) {
    echo "ERROR: 作業用ディレクトリが既にあります。`n--> $baseDir"
    exit
}
mkdir $baseDir > $nul
cp $targetTarGz $baseDir
cd $baseDir

# アーカイブを全て再帰的に解凍
while (ls -r *.tar.gz) {
    ls -r *.tar.gz | %{
        echo $_.Name
        tar xf $_.FullName
        rm $_.FullName
    }
}
# 直下以外のファイルを全て直下へ移動
ls -Dir | ls -File -r | %{
    mv $_.FullName $baseDir
}
# 残ったフォルダを全て削除
ls -Dir | % {
    rm -Force -r $_
}

# ファイルリネーム
ls -File "*-*-*-*-*" | %{
    $aryName = $_.Name -split "-"
    if ($aryName.Count -eq 5) {
        mv $_.Name (@($aryName[0],$aryName[2],$aryName[3],$aryName[4]) -join "-")
    }
}

# リストファイルヘッダ
@("filetype","hostname","line") -join "`t" >> $listFile

# フォルダ分割
ls -File "*-*-*-*" | %{
    $aryName = $_.Name -split "-"
    if ($aryName.Count -eq 4) {
        $hostname = $aryName[2]
        mkdir -f $hostname > $nul
        mv $_.Name $hostname

        @($aryName[0],$hostname,$_.Name) -join "`t" >> $listFile
    }
}

# 元のディレクトリへ戻る
cd "$baseDir\.."
